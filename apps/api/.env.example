# Copy to .env and adjust as needed. Never commit .env.

# App
PORT=3001

# PostgreSQL (matches docker-compose.yml)
# NOTE: host port is 5433 because a native PostgreSQL already uses 5432 on this machine
DATABASE_URL="postgresql://codearena:codearena@localhost:5433/codearena?schema=public"

# Redis (matches docker-compose.yml) — used by BullMQ starting Phase 2
REDIS_HOST=localhost
REDIS_PORT=6379
# Generate your own with:  openssl rand -base64 32
JWT_SECRET="replace-me-with-a-32-byte-random-value"