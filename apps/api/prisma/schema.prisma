// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider            = "prisma-client"
  output              = "../generated/prisma"
  // This app is CommonJS (no "type":"module" in package.json).
  // Without these, Prisma 7 emits ESM and Node fails with
  // "exports is not defined in ES module scope".
  moduleFormat        = "cjs"
  importFileExtension = ""
  // Generated Prisma client stays inside the src directory
  // Compatibility with Jest (CommonJS environment)
  // No .js extension conflicts during testing
  runtime             = "nodejs"
  // Partial indexes (block E): `where:` on @@index.
  previewFeatures     = ["partialIndexes"]
}

// The worker's own client, generated from this same schema. One schema means
// a renamed column breaks the worker's build, not its first job in production.
generator worker {
  provider            = "prisma-client"
  output              = "../../worker/src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = ""
  runtime             = "nodejs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum Language {
  TYPESCRIPT
  PYTHON
  CPP
  JAVA
  JAVASCRIPT
}

enum Verdict {
  PENDING
  ACCEPTED
  WRONG_ANSWER
  TIME_LIMIT
  RUNTIME_ERROR
  COMPILE_ERROR
  MEMORY_LIMIT
  OUTPUT_LIMIT
  JUDGING // a worker holds the claim (claimedBy, claimedAt)
  SYSTEM_ERROR // our failure, after the last retry: the user should resubmit
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  username     String @unique
  passwordHash String // NEVER a column called `password`
  role         Role   @default(USER)

  // Glicko-2 rating fields — added now so Week 5 needs no migration
  rating          Float @default(1500)
  ratingDeviation Float @default(350)
  volatility      Float @default(0.06)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  submissions   Submission[]
  refreshTokens RefreshToken[]
}

model Problem {
  id               Int        @id @default(autoincrement()) // frontend contract: a NUMBER
  slug             String     @unique
  title            String
  difficulty       Difficulty
  description      String[] // array of paragraphs
  constraints      String[]
  starterCode      Json // language -> code map
  // Denormalised for now: the seed data carries them and there are no
  // Submissions yet. Week 2 can compute these from Submission instead.
  acceptanceRate   Float      @default(0)
  totalSubmissions Int        @default(0)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  timeLimitMs      Int        @default(2000)
  memoryLimitMb    Int        @default(256)

  examples    ProblemExample[]
  testCases   TestCase[]
  submissions Submission[]
  tags        Tag[]

  @@index([difficulty]) // list page filters by difficulty
}

model ProblemExample {
  id          Int     @id @default(autoincrement())
  problemId   Int
  problem     Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input       String
  output      String
  explanation String?
  order       Int

  @@index([problemId]) // FK — always indexed
}

model Tag {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  problems Problem[]
}

model TestCase {
  id        Int     @id @default(autoincrement())
  problemId Int
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  input     String
  expected  String
  isSample  Boolean @default(false)
  order     Int

  @@index([problemId])
}

model Submission {
  id        String   @id @default(cuid()) // never a guessable id for user data
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  problemId Int
  problem   Problem  @relation(fields: [problemId], references: [id])
  language  Language
  verdict   Verdict  @default(PENDING)
  code      String
  runtimeMs Int?
  createdAt DateTime @default(now())
  // The claim: which worker is judging it, and since when. A claim older
  // than the lease belongs to a dead worker and can be taken over.
  claimedBy String?
  claimedAt DateTime?

  // History, keyset-paginated on (createdAt, id): `id` in the index removes
  // the sort on ties (docs/perf/02).
  @@index([userId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([problemId, verdict]) // acceptance rates (docs/perf/05)
  // Only accepted rows, about 30 %: "solved" badges and the top-users query
  // (docs/perf/03, 04).
  @@index([userId, problemId], map: "Submission_solved_idx", where: raw("verdict = 'ACCEPTED'"))
  // The latest accepted solutions of a problem (docs/perf/05).
  @@index([problemId, createdAt(sort: Desc)], map: "Submission_accepted_recent_idx", where: raw("verdict = 'ACCEPTED'"))
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique // the HASH, never the token itself
  family    String // rotation: reuse kills the whole family
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  // userId first: deleting a user cascades here (ON DELETE CASCADE).
  @@index([userId, family])
  // revokeFamily: WHERE family = … (I-16, docs/perf/06).
  @@index([family])
}
